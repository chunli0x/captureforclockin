# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.db

# Secrets — real signing keys. Never commit them.
# The verifier key authorizes every attestation: anyone holding it can mint
# attestations the chain will accept as ours.
backend/.env
backend/treasury.json
backend/usdc-treasury.json
backend/verifier.json
backend/verifier.dev.json
*.json.key

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
.idea/
*.iml
captures/

# OS
.DS_Store

# Generated datasets (backend/data is dev-local output)
backend/data/
backend/.solana-cli.yml

# Program keypair controls the program address and upgrade authority.
programs/*/program-keypair.json
deployer.json
target/

# Bootstrap state (records created mints so a re-run reuses them)
backend/.bootstrap-state.json

backend/.venv/
seed_images/

# Persistent Android distribution signing credentials (operator-provided).
android/signing.properties
*.jks
*.keystore
