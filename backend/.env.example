# Capture backend — environment template (public repo: PLACEHOLDERS ONLY).
#
# Copy to backend/.env and fill in real values, OR just run
#   ./scripts/dev_bootstrap.sh
# which generates throwaway dev-only secrets and writes backend/.env for you.
#
# Never commit a real .env. The real operator key, media key, and verifier
# keypair live out of band and are gitignored.

# --- Database ---------------------------------------------------------------
# Default: the PostgreSQL service from docker-compose.yml (repo root).
SEEKER_DATABASE_URL=postgresql+psycopg://seeker:seeker@localhost:5432/seeker

# No-Docker option: uncomment these two lines instead of the line above.
# SEEKER_DATABASE_URL=sqlite:///./seeker.db
# SEEKER_LOCAL_SQLITE=true

# --- Operator authentication (>= 32 chars) ----------------------------------
SEEKER_OPERATOR_KEY=CHANGE_ME_operator_key_at_least_32_characters_long

# --- Media encryption: base64 of exactly 32 random bytes --------------------
SEEKER_MEDIA_KEY=CHANGE_ME_base64_of_32_random_bytes_REPLACE_ME=

# --- Public devnet program + token addresses (NOT secrets) ------------------
SEEKER_PROGRAM_ID=5TiDwP86k95yfQWzExrPTj5qcKxED99z8pW9fN81u5SV
SEEKER_SKR_MINT=3aGKaVL7GpcTcTuKjkyirnVeyNG1JGFNyGGueu8mAGbM

# --- Solana (devnet) --------------------------------------------------------
SEEKER_RPC_URL=https://api.devnet.solana.com
SEEKER_CLUSTER=devnet

# --- Verifier keypair -------------------------------------------------------
# A judge never has the real verifier key (it authorizes every attestation and
# is installed out of band, never committed). dev_bootstrap.sh generates a
# throwaway DEV-ONLY keypair so the backend can start; anything that needs the
# real verifier on-chain will fail until you point this at your own keypair.
SEEKER_VERIFIER_KEY_FILE=verifier.dev.json

# --- Devnet treasury (optional; 0600, gitignored) ---------------------------
# Holds the test $SKR mint authority for faucet, bond, and payout (6 decimals).
# Leave blank for local dev: faucet and payout fail closed without an authority.
# Test $SKR on devnet, not real value.
SEEKER_TREASURY_KEY_FILE=

# --- Auth domain ------------------------------------------------------------
SEEKER_DOMAIN=localhost

# --- Optional moderation (media uploads reject while these are blank) -------
# Leave blank for local dev; the API still starts and /health still responds.
SEEKER_SIGHTENGINE_USER=
SEEKER_SIGHTENGINE_SECRET=
SEEKER_HIVE_KEY=

# --- Liveness ---------------------------------------------------------------
SEEKER_LIVENESS_REQUIRED=true
# Explicit hackathon opt-in only. False rejects the fixed demo digest and
# hides Android's Continue (demo) button. Existing demo records also stop passing.
SEEKER_LIVENESS_DEMO=false
SEEKER_LIVENESS_VERIFICATION_SECONDS=3600
